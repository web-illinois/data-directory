@page "/search/webtoolslogs"

<PageTitle>Webtools Log | Illinois</PageTitle>

<div class="iled-section">
    <h1>Webtools Log</h1>

    <p>This page shows the webtools log. </p>

    <div class="iled-input-box-parent">
        <div class="iled-input-box">
            <label for="ed-netid">Search Text</label>
            <input id="ed-netid" type="text" @bind="SearchText">
        </div>
    </div>
    <div class="iled-buttons-left">
        <button class="ilw-button" @onclick="RefreshInformation">Refresh Information</button>
    </div>


    @if (this.LogItems != null) {
        <h2>Changes</h2>
        @if (this.LogItems.Count > 0) {
            <ul>
                @foreach (var log in this.LogItems) {
                    <li style="list-style: none; margin: 0;"><details><summary style="padding: 5px;">@log.ToolkitType: @log.Success - @log.LastUpdated.ToShortDateString() @log.LastUpdated.ToShortTimeString() </summary>@log.Log</details></li>
                }
            </ul>
        } else {
            <p>No logs.</p>
        }
    }
</div>