@page "/office/orgchart"

<PageTitle>Organization Chart | Illinois</PageTitle>
<NavigationLock OnBeforeInternalNavigation=this.LocationChangingHandler ConfirmExternalNavigation=_isDirty />
<div class="iled-section">
    <h1>@OfficeTitle Organization Chart</h1>
    <p>Edit your office’s organization chart.</p>
    @if (!string.IsNullOrWhiteSpace(ShowBackButton) && ShowBackButton == "search") {
        <p><a href="/search/offices" class="ilw-button">Back to Searching for Offices</a></p>
    }
</div>
@if (!OfficeId.HasValue) {
    <MultiChoice @ref="_multiChoice" Type="MultiChoiceTypeEnum.Office" AreaOfficeThinObjects="_officeThinObjects" AreaOfficeParentThinObjects="_areaThinObjects" OnClickCallback="AssignId"></MultiChoice>
} else if (Office != null && JobProfileThinObjects != null) {
    <div class="iled-section-split">
        <div class="iled-input-box-parent">
            <div class="iled-input-box">
                <label for="ed-jobprofile1">Secondary Job Profile</label>
                <select id="ed-jobprofile1" @bind="Office.ManagerJobProfileId1" @bind:after="SetDirty">
                    <option value="">None</option>
                    @foreach (var job in JobProfileThinObjects) {
                        <option value="@job.JobProfileId">@job.Display</option>
                    }
                </select>
            </div>
            <div class="iled-instructions">
                The name and title of the manager for this office is pulled from the Job Profile selected here. If you would like to override the name and title, please use the fields below.
            </div>
        </div>
        <div class="iled-input-box-parent">
            <div class="iled-input-box">
                <label for="ed-jobprofile2">Secondary Job Profile</label>
                <select id="ed-jobprofile2" @bind="Office.ManagerJobProfileId2" @bind:after="SetDirty">
                    <option value="">None</option>
                    @foreach (var job in JobProfileThinObjects) {
                        <option value="@job.JobProfileId">@job.Display</option>
                    }
                </select>
            </div>
            <div class="iled-instructions">
                The name and title of a secondary person for this office is pulled from the Job Profile selected here. If you would like to override the name and title, please use the fields below.
            </div>
        </div>
    </div>
    <div class="iled-input-box-parent">
        <div class="iled-input-box">
            <label for="ed-line1">Override for Line 1:</label>
            <input id="ed-line1" type="text" @bind="Office.ManagerOverride1" @bind:after="SetDirty">
        </div>
        <div class="iled-instructions">
            If you would like to override the name and title of the manager for this office, please use this field. Otherwise, the name and title will be pulled from the Job Profile selected above.
        </div>
    </div>
    <div class="iled-input-box-parent">
        <div class="iled-input-box">
            <label for="ed-line2">Override for Line 2:</label>
            <input id="ed-line2" type="text" @bind="Office.ManagerOverride2" @bind:after="SetDirty">
        </div>
        <div class="iled-instructions">
            If you would like to override the name and title of the manager for this office, please use this field. Otherwise, the name and title will be pulled from the Job Profile selected above.
        </div>
    </div>
    <div class="iled-input-box-parent">
        <div class="iled-input-box">
            <label for="ed-includeoffice">Include Office Name in Organization Chart?</label>
            <input id="ed-includeoffice" type="checkbox" @bind="Office.ManagerIncludeOffice" @bind:after="SetDirty">
        </div>
        <div class="iled-instructions">
            Choose this if you want to include the office name in the organization chart. If you do not choose this, only the manager's name and title will be displayed.
        </div>
    </div>
    <div class="iled-buttons-left">
        <button class="ilw-button ilw-theme-orange-1" @onclick="Send" @onblur="RemoveMessage">Save</button>
        <ClearCacheButton></ClearCacheButton>
    </div>
    <ToastPopup></ToastPopup>
}