@page "/office/webtools"

<PageTitle>Office Webtools Integration | Illinois</PageTitle>
<NavigationLock OnBeforeInternalNavigation=this.LocationChangingHandler ConfirmExternalNavigation=_isDirty />
<div class="iled-section">
    <h1>@OfficeTitle Webtools Integration</h1>
    <p>Integrate with Webtools to manage office information and settings. Note that saving this will overwrite any existing information, including job profiles associated with this office.</p>
</div>
@if (!OfficeId.HasValue) {
    <MultiChoice @ref="_multiChoice" Type="MultiChoiceTypeEnum.Office" AreaOfficeThinObjects="_officeThinObjects" AreaOfficeParentThinObjects="_areaThinObjects" OnClickCallback="AssignId"></MultiChoice>
} else if (Office != null && OfficeSettings != null) {
    <div class="iled-input-box-parent">
        <div class="iled-input-box">
            <label for="ed-departmentid">Department Code</label>
            <input type="text" id="ed-departmentid" @bind="Office.DepartmentId" @bind:after="SetDirty"></input>
        </div>
        <div class="iled-instructions">
            The department code is used to identify the office within the organization and is not exposed to the end user.
        </div>
    </div>
    <div class="iled-input-box-parent">
        <div class="iled-input-box">
            <label for="ed-departmentidlookup">Department Code Lookup</label>
            <select id="ed-departmentidlookup" type="checkbox" required @bind="DepartmentCodeLookup" @bind:after="SetCall">
                <option value=""></option>
                @foreach (var departmentCode in DepartmentCodes) {
                    <option value="@departmentCode.Key">@departmentCode.Key - @departmentCode.Value</option>
                }
            </select>
        </div>
        <div class="iled-instructions">
            Lookup for department ID
        </div>
    </div>
    <div class="iled-input-box-parent">
        <div class="iled-input-box">
            <label for="ed-serviceid">Service ID</label>
            <input type="text" id="ed-serviceid" @bind="Office.ServiceId" @bind:after="SetDirty"></input>
        </div>
        <div class="iled-instructions">
            The service ID is used to identify the office within the organization and is not exposed to the end user.
        </div>
    </div>
    <div class="iled-input-box-parent">
        <div class="iled-input-box">
            <label for="ed-serviceidlookup">Service Code Lookup</label>
            <select id="ed-serviceidlookup" type="checkbox" required @bind="ServiceCodeLookup" @bind:after="SetCall">
                <option value=""></option>
                @foreach (var serviceCode in ServiceCodes) {
                    <option value="@serviceCode.Key">@serviceCode.Key - @serviceCode.Value</option>
                }
            </select>
        </div>
        <div class="iled-instructions">
            Lookup for service ID
        </div>
    </div>
    <div class="iled-input-box-parent">
        <div class="iled-input-box">
            <label for="ed-jobspecific">WebTools Automatic Import</label>
            <select id="ed-jobspecific" type="checkbox" required @bind="AutomaticImport" @bind:after="SetDirty">
                <option value="0">No automatic import</option>
                <option value="1">Import just the office</option>
                <option value="2">Import the office and employees</option>
            </select>
        </div>
        <div class="iled-instructions">
            Check this box if you want to automatically import your office from Webtools into the directory. This will overwrite any existing information. 
        </div>
    </div>
    <div class="iled-buttons-left">
        <button class="ilw-button ilw-theme-orange-1" @onclick="Send" @onblur="RemoveMessage">Save</button>
        <ClearCacheButton></ClearCacheButton>
    </div>
    <ToastPopup></ToastPopup>
}